POSTGRES_USER=hakaton_team
POSTGRES_PASSWORD=very_very_secret_password3000
POSTGRES_DB=smart_dairy

DB_USER=hakaton_team
DB_PASSWORD=very_very_secret_password3000
DB_NAME=smart_dairy
DB_PORT=5432
DB_HOST=127.0.0.1

# === НАСТРОЙКИ REDIS ===
# Для локального запуска в терминале пишите 127.0.0.1
# Для запуска внутри Docker наш compose сам подменит это значение, так что оставляем локальный IP
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# === НАСТРОЙКИ БЕЗОПАСНОСТИ (JWT) ===
# Сгенерируйте случайную строку (можно потыкать по клавиатуре)
JWT_SECRET_KEY=super_secret_key_for_smart_diary_hackathon_2026
JWT_ALGORITHM=HS256
# Время жизни токенов в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200
# 30 дней (60 * 24 * 30)

# === НАСТРОЙКИ ПОЧТЫ (SMTP) ===
# Например, для Яндекса: smtp.yandex.ru, для Mail.ru: smtp.mail.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your_diary_app@yandex.ru
# ВАЖНО: это не пароль от почты, а специальный "Пароль приложения", созданный в настройках безопасности вашей почты
SMTP_PASSWORD=very_very_secret_password3000

USE_MOCK_LLM=True
YANDEX_API_KEY=секретный_ключ_из_консоли_яндекса
YANDEX_FOLDER_ID=идентификатор_каталога_облака
MAX_BOT_TOKEN=твой_длинный_токен_от_бота
